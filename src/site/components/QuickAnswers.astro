---
const answers = [
  ['/v/antigravity', 'Antigravity 提示 403 或服务停用'],
  ['/v/claude', 'Claude 账号或组织被停用'],
  ['/v/codex', 'Codex 或 ChatGPT 账号被停用'],
  ['/tips/antigravity-paid-plan-starter-quota', '付费后仍显示 Starter Quota'],
  ['/tips/claude-max-google-play-recovery', '解封后 Max 显示 Free'],
  ['/radar', '额度什么时候可能重置'],
];
---

<section class="quick-answers wrap" aria-labelledby="quick-answers-title">
  <h2 id="quick-answers-title">你遇到的是哪一种？</h2>
  <ul>
    {answers.map(([href, label]) => (
      <li>
        <a href={href}>{label}</a>
      </li>
    ))}
  </ul>
</section>

<style>
  .quick-answers {
    padding-block: 24px 8px;
  }
  h2 {
    margin: 0 0 12px;
    font: 900 var(--fs-l) / 1.3 var(--font-carve);
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: block;
    height: 100%;
    padding: 10px 12px;
    border: 2px solid var(--ink);
    font-size: var(--fs-s);
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    background: var(--ink);
    color: var(--paper);
  }
</style>
