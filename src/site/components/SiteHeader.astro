---
interface Props {
  current: string;
}
const { current } = Astro.props;
const admin = current === '/admin';
const links = admin
  ? [
      ['/admin', '审核'],
      ['/', '回到纪念墙'],
    ]
  : [
      ['/', '纪念墙'],
      ['/submit', '立碑'],
      ['/epitaph', '墓志铭卡片'],
      ['/appeal', '官方申诉入口'],
      ['/rules', '使用须知'],
    ];
---

<header class="topbar">
  <div class="wrap">
    <a class="brand" href="/">
      <img src="/assets/logo.svg" alt="" width="32" height="32" />
      号没了
    </a>
    <nav class="nav" aria-label={admin ? '后台导航' : '主导航'}>
      {links.map(([href, text]) => (
        <a href={href} aria-current={current === href ? 'page' : undefined}>
          {text}
        </a>
      ))}
    </nav>
    <nav class="locale-switch" aria-label="语言">
      <a href="/" data-locale-switch="zh" lang="zh-CN" aria-current="page">
        中文
      </a>
      <a href="/en/" data-locale-switch="en" lang="en">
        English
      </a>
    </nav>
  </div>
</header>
