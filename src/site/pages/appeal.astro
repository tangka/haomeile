---
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteOrigin } from '../../shared/site';

const SITE = siteOrigin(import.meta.env.PUBLIC_SITE_ORIGIN);

const channels = [
  {
    id: 'antigravity',
    name: 'Antigravity',
    guidance:
      '个人账号遇到 Antigravity 服务停用或 403 权限拒绝时，用受影响的 Google 账号登录并提交申诉。',
    facts: [
      [
        '等多久',
        '带 Google 标识的论坛回复说，自动处理大约 48 到 72 小时，有时更久，不会发邮件通知。',
      ],
      [
        '提交几次',
        '一次。论坛回复说，重复提交不会加快，每个账号只有一次通过申诉恢复的机会。',
      ],
      ['怎么看结果', '退出客户端再登录。通过后，下次登录时自动恢复。'],
    ],
    appeal: 'https://forms.gle/hGzM9MEUv2azZsrb9',
    action: 'Antigravity 申诉表单',
    help: 'https://support.google.com/accounts/answer/40695',
    helpLabel: 'Google 账号停用说明',
    links: [
      ['/v/antigravity#answer', 'Antigravity 申诉处理步骤'],
      ['/v/antigravity#wait', '看别人等了多久'],
      ['/v/antigravity', '查看 Antigravity 停用案例'],
    ],
  },
  {
    id: 'claude',
    name: 'Claude',
    guidance: '用受限的 Claude 账号登录，在账号限制页提交申诉。',
    facts: [
      [
        '先排除',
        'Claude Code 提示“This organization has been disabled”时，先查是不是用了旧的 ANTHROPIC_API_KEY，别急着申诉。',
      ],
      [
        '怎么进表单',
        '要用被停用的账号登录才能打开。组织被暂停时，点它旁边的“Request a review”。',
      ],
    ],
    appeal: 'https://claude.ai/restricted',
    action: 'Claude 账号申诉',
    help: 'https://support.claude.com/en/articles/8241253-safeguards-warnings-and-appeals',
    helpLabel: 'Claude 申诉说明',
    links: [
      ['/v/claude#answer', 'Claude 停用处理步骤'],
      ['/v/claude', '查看 Claude 停用案例'],
    ],
  },
  {
    id: 'codex',
    name: 'Codex',
    guidance:
      '优先使用 OpenAI 通知邮件里的申诉链接。账号永久停用且无法查看通知时，可用下方表单。没收到通知，可联系帮助中心。',
    facts: [
      [
        '写什么',
        '用户 ID 和组织 ID（有的话）、账号平时怎么用、为什么认为是误判。不要填完整卡号或安全码。',
      ],
      ['结果', 'OpenAI 说明，申请复核不保证账号会恢复。'],
    ],
    appeal: 'https://openai.com/form/appeal/',
    action: 'OpenAI 申诉表单',
    help: 'https://help.openai.com/',
    helpLabel: 'OpenAI 帮助中心',
    links: [
      ['/v/codex#answer', 'Codex 停用处理步骤'],
      ['/v/codex#wait', '看别人等到了什么结果'],
      ['/v/codex', '查看 Codex 停用案例'],
    ],
  },
];

const faqs = [
  {
    question: 'Antigravity 申诉要等多久？没收到邮件怎么办？',
    answer:
      '带 Google 标识的论坛回复说，自动处理大约 48 到 72 小时，有时更久，不会发邮件通知；通过后，下次登录时自动恢复。本站收录的公开帖里，有人申诉约 66 小时后恢复，也有人等了一周以上仍未恢复。这些是作者自述，未经本站核实，不能当作成功率。',
  },
  {
    question: 'Claude 封号或组织停用后怎么申诉？解封后仍显示 Free 怎么办？',
    answer:
      '先登录受限的 Claude 账号访问 claude.ai/restricted 提交申诉；若仅弹出身份验证窗口，先确认所在地区并按官方指引完成证件验证。如果账号恢复后已付费的 Max 或 Pro 仍显示 Free，请核对 Apple、Google Play 或网页账单收据，并从 Claude 网页左下角「获取帮助」联系官方支持核对订单。',
  },
  {
    question: 'Codex 或 ChatGPT 账号停用怎么申诉？401 报错一定是永久封号吗？',
    answer:
      '先查注册邮箱里的 OpenAI 通知邮件，优先使用邮件内的申诉链接；若账号永久停用且无法查看通知，再使用 OpenAI 官方申诉表单，未收到通知则通过 OpenAI 帮助中心联系支持。客户端出现 401 时，先核对网页端账号状态和登录凭据，社区案例中存在 401 与账号停用状态不一致的情况。',
  },
  {
    question: 'Antigravity 出现 403 或服务停用怎么处理？付费后仍显示 Starter Quota 怎么办？',
    answer:
      '个人 Google 账号遇到 Antigravity 服务停用或 403 权限拒绝时，先核对所在地区与已授权的第三方连接，再使用受影响的 Google 账号提交官方申诉表单，并避免短时间重复提交。如果是已开通 Google AI Pro 或 Ultra 但客户端仍显示 Starter Quota，请先核对客户端登录邮箱、查看额度页是否提示年龄验证，验证后退出重新登录。',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'zh-CN',
    mainEntity: faqs.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '纪念墙',
        item: SITE + '/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: '官方申诉入口',
      },
    ],
  },
];
---

<SiteLayout
  title="Antigravity、Claude、Codex 申诉：官方表单与等待时间 · 号没了"
  description="Antigravity、Claude、Codex 账号停用或 403 时的官方申诉表单、用哪个账号提交、要等多久、能提交几次，以及申诉时写什么。"
  path="/appeal"
  current="/appeal"
  jsonLd={jsonLd}
>
  <main class="page">
    <div class="wrap">
      <div class="page-head">
        <h1>Antigravity、Claude、Codex 官方申诉入口</h1>
        <p>
          汇总 Claude、Codex 与 Antigravity 的官方申诉渠道、常见报错区分和排查入口。所有链接均指向对应厂商官网或官方表单。
        </p>
      </div>

      <div class="vendor-list">
        {channels.map(
          ({
            id,
            name,
            guidance,
            facts,
            appeal,
            action,
            help,
            helpLabel,
            links,
          }) => (
            <article class="vendor" id={id}>
              <h2>{name}</h2>
              <p>{guidance}</p>
              <a
                class="btn btn-primary"
                href={appeal}
                target="_blank"
                rel="noopener noreferrer"
              >
                {action}
              </a>
              <dl class="appeal-facts">
                {facts.map(([term, text]) => (
                  <>
                    <dt>{term}</dt>
                    <dd>{text}</dd>
                  </>
                ))}
              </dl>
              <div class="appeal-links">
                <a href={help} target="_blank" rel="noopener noreferrer">
                  {helpLabel}
                </a>
                {links.map(([href, label]) => (
                  <a href={href}>{label}</a>
                ))}
              </div>
            </article>
          ),
        )}
      </div>

      <div class="doc">
        <h2>申诉时可以写什么</h2>
        <ul>
          <li>出事的时间，以及你当时在做什么。</li>
          <li>你平时用它做什么，比如写代码、写论文、处理工作文档。</li>
          <li>收到的通知原文。</li>
          <li>提交一次后保留工单或回执，避免短时间内重复提交多份表单。</li>
        </ul>

        <h2>分产品常见问题与排查</h2>
        {faqs.map(({ question, answer }) => (
          <section class="faq-item">
            <h3>{question}</h3>
            <p>{answer}</p>
          </section>
        ))}

        <h2>相关实操指南</h2>
        <ul>
          <li>
            <a href="/tips/claude-max-google-play-recovery">
              Claude 解封后还是 Free？查看 Google Play 的 Max 订阅排查步骤
            </a>
          </li>
          <li>
            <a href="/tips/claude-sign-up-identity-verification">
              Claude 注册或结账弹出身份验证时怎么核对
            </a>
          </li>
          <li>
            <a href="/tips/antigravity-paid-plan-starter-quota">
              Antigravity 开通 Ultra 或 Pro 后仍显示 Starter Quota 的排查步骤
            </a>
          </li>
          <li>
            <a href="/tips/antigravity-first-install-google-ai-pro">
              Antigravity 桌面端登录与 Google AI Pro 开通核对
            </a>
          </li>
          <li>
            <a href="/tips/chatgpt-plus-iphone-subscription">
              ChatGPT Plus 与 Codex 账号订阅到账核对
            </a>
          </li>
        </ul>
      </div>
    </div>
  </main>
</SiteLayout>

<style>
  .vendor {
    grid-template-rows: auto auto auto 1fr auto;
  }
  .vendor .btn-primary {
    justify-self: start;
  }
  .appeal-facts {
    display: grid;
    gap: 2px;
    align-content: start;
    margin: 0;
    font-size: var(--fs-s);
    line-height: 1.6;
  }
  .appeal-facts dt {
    font-weight: 700;
  }
  .appeal-facts dd {
    margin: 0 0 8px;
  }
  .appeal-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-block-start: 8px;
  }
  .appeal-links a {
    word-break: normal;
    overflow-wrap: anywhere;
  }
  .faq-item {
    margin-block-start: 16px;
    padding-block-start: 16px;
    border-block-start: 1px solid var(--stone-shade);
  }
  .faq-item h3 {
    margin-block: 0 8px;
    font-size: var(--fs-m);
    line-height: 1.4;
  }
  .faq-item p {
    margin-block: 0;
    line-height: 1.7;
  }
</style>
