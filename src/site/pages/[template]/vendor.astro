---
export function getStaticPaths() {
  return [{ params: { template: '_templates' } }];
}
import SiteLayout from '../../layouts/SiteLayout.astro';
import Tally from '../../components/Tally.astro';
import Wall from '../../components/Wall.astro';
import Timeline from '../../components/Timeline.astro';
---

<SiteLayout
  title="账号停用、封号经历 · 号没了"
  description="Claude、Codex 和 Antigravity 的账号经历、用户投稿与社区整理。"
  path="/"
  current="/"
  robots="noindex,follow"
>
  <main>
    <div class="page">
      <div class="wrap page-head">
        <h1 data-ssr="page-title">账号的墓碑</h1>
        <p data-ssr="vendor-intro">这里收录账号经历的用户投稿和社区整理。</p>
        <section class="vendor-answer doc" data-ssr="vendor-answer" hidden></section>
        <p class="vendor-summary" data-ssr="vendor-summary" hidden></p>
        <nav class="vendor-links" data-ssr="vendor-links" aria-label="相关入口"></nav>
      </div>
    </div>
    <Tally />
    <Wall />
    <Timeline />
  </main>
</SiteLayout>

<style>
  .vendor-summary {
    margin: 14px 0 0;
    padding: 10px 14px;
    border-inline-start: 4px solid var(--grass-deep);
    background: color-mix(in srgb, var(--stone) 55%, transparent);
    font-size: var(--fs-xs);
    line-height: 1.6;
  }
  .vendor-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin-block-start: 16px;
    font-size: var(--fs-xs);
  }
  .vendor-links :global(a) {
    padding: 5px 10px;
    border: 1.5px solid var(--ink);
    text-decoration: none;
  }
  .vendor-links :global(a:hover),
  .vendor-links :global(a:focus-visible) {
    background: var(--ink);
    color: var(--paper);
  }
  .vendor-answer {
    margin-block-end: 36px;
  }
  .vendor-answer[hidden] {
    display: none;
  }
  .vendor-answer :global(h2) {
    margin: 26px 0 8px;
  }
  .vendor-answer :global(.answer-table) {
    overflow-x: auto;
  }
  .vendor-answer :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-s);
  }
  .vendor-answer :global(th),
  .vendor-answer :global(td) {
    padding: 6px 10px 6px 0;
    border-block-end: 1px solid var(--stone-shade);
    text-align: start;
    vertical-align: top;
  }
  .vendor-answer :global(td:not(:nth-child(4))) {
    white-space: nowrap;
  }
  .vendor-answer :global(td:nth-child(4)) {
    min-width: 9em;
  }
  .vendor-links:empty {
    display: none;
  }
</style>
