---
export function getStaticPaths() {
  return [{ params: { template: '_templates' } }];
}
import SiteLayout from '../../layouts/SiteLayout.astro';
import ReportDialog from '../../components/ReportDialog.astro';
---

<SiteLayout
  title="墓碑详情 · 号没了"
  description="查看账号经历、内容来源与申诉状态。"
  path="/"
  ogType="article"
  robots="index,follow,noarchive,max-image-preview:large"
>
  <main class="detail">
    <div class="wrap">
      <a class="back" href="/">
        回到纪念墙
      </a>
      <!-- 详情卡由 createTombCard(t, { detail: true }) 渲染；正式站点数据来自 GET /api/tombstones/:id -->
      <div id="slot" data-ssr="detail" data-tomb-id=""></div>
      <div class="detail-actions">
        <button class="btn" type="button" id="copy-link">
          复制这块碑的链接
        </button>
        <a class="btn" href="/epitaph">
          做一张墓志铭卡片
        </a>
        <button class="btn btn-quiet" type="button" id="open-report">
          举报
        </button>
      </div>
      <section class="next-steps" data-ssr="next-steps" aria-label="下一步"></section>
    </div>
  </main>
  <ReportDialog />
  <script>
    import '../../scripts/detail';
  </script>
</SiteLayout>

<style>
  .next-steps {
    margin-block-start: 22px;
    padding-block-start: 16px;
    border-block-start: 1px solid var(--stone-shade);
    font-size: var(--fs-s);
  }
  .next-steps :global(h2) {
    margin: 14px 0 6px;
    font: 900 var(--fs-m) / 1.3 var(--font-carve);
  }
  .next-steps :global(ul) {
    margin: 0;
    padding-left: 1.2em;
  }
  .next-steps :global(li) {
    margin-bottom: 4px;
    overflow-wrap: anywhere;
  }
  :global(.tomb-compiled) {
    font-size: var(--fs-xs);
    opacity: 0.85;
  }
  .next-steps:empty {
    display: none;
  }
</style>
