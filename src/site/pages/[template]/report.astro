---
export function getStaticPaths() {
  return [{ params: { template: '_templates' } }];
}
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout
  title="月度数据报告 · 号没了"
  description="号没了按月汇总的 Claude、Codex 与 Antigravity 公开记录数据与统计口径。"
  path="/"
  ogType="article"
  robots="index,follow,max-image-preview:large"
>
  <main class="page">
    <div class="wrap">
      <article class="doc report-page">
        <div class="page-head">
          <h1 data-ssr="report-title">月度数据报告</h1>
          <p class="report-lead" data-ssr="report-lead"></p>
        </div>
        <div class="report-body" data-ssr="report-body"></div>
      </article>
    </div>
  </main>
</SiteLayout>

<style>
  .report-page {
    margin-inline: auto;
  }
  .report-lead {
    line-height: 1.7;
  }
  .report-body :global(h2) {
    margin: 28px 0 10px;
  }
  .report-body :global(.report-table) {
    overflow-x: auto;
    margin-block: 10px 16px;
  }
  .report-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-s);
  }
  .report-body :global(th),
  .report-body :global(td) {
    padding: 7px 12px 7px 0;
    border-block-end: 1px solid var(--stone-shade);
    text-align: start;
    vertical-align: top;
  }
  .report-body :global(code) {
    font-size: 0.92em;
  }
</style>
