---
import SiteLayout from '../../layouts/SiteLayout.astro';
import RadarMark from '../../components/RadarMark.astro';
import RadarAbout from '../../components/RadarAbout.astro';

export function getStaticPaths() {
  return [{ params: { template: '_templates' } }];
}
---

<SiteLayout
  title="重置雷达：Codex、Claude Code、Antigravity 额度重置估计 · 号没了"
  description="重置雷达每 30 分钟估计一次 Codex、Claude Code 和 Antigravity 未来 24 小时额度重置的可能，非官方，基于社区观测信号。支持超过 80% 时邮件提醒。"
  path="/radar"
  current="/radar"
>
  <main class="page">
    <div class="wrap">
      <div class="page-head">
        <h1>重置雷达</h1>
        <p>
          估计 Codex、Claude Code 和 Antigravity 未来 24
          小时发生额度重置的可能。这是非官方估计。
        </p>
      </div>
      <section
        class="gate-card"
        aria-labelledby="radar-gate-title"
        data-radar-verify
      >
        <div class="gate-mark">
          <RadarMark />
        </div>
        <h2 id="radar-gate-title">查看当前估计</h2>
        <p>请完成人机验证后进入。</p>
        <div class="gate-challenge" data-radar-challenge></div>
        <p class="gate-status" data-radar-status role="status"></p>
        <noscript>请开启 JavaScript 完成验证。</noscript>
        <button class="btn btn-primary" type="button" data-radar-start hidden>
          重新验证
        </button>
      </section>
      <RadarAbout />
    </div>
  </main>
  <script>
    import '../../scripts/radar';
  </script>
</SiteLayout>

<style>
  .gate-card {
    width: min(100%, 32rem);
    color: var(--sky-ink);
    padding: clamp(14px, 4vw, 36px);
    border: 2px solid var(--sky-ink);
    background: var(--paper);
    box-shadow: 8px 8px 0 color-mix(in srgb, var(--sky-ink) 76%, transparent);
  }

  .gate-mark {
    --radar-mark-size: 54px;
    margin-bottom: 12px;
  }

  .gate-card h2 {
    margin: 0 0 8px;
    font: 900 var(--fs-l) / 1.2 var(--font-carve);
  }

  .gate-card p {
    margin: 0;
  }

  .gate-challenge {
    min-height: 68px;
    margin-top: 22px;
  }

  .gate-status,
  noscript {
    color: var(--sky-ink);
    font-size: var(--fs-s);
  }

  .gate-status:not(:empty),
  button:not([hidden]) {
    margin-top: 10px;
  }

  button[hidden] {
    display: none;
  }
</style>
