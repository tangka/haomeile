---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import Tally from '../components/Tally.astro';
import Wall from '../components/Wall.astro';
import Timeline from '../components/Timeline.astro';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: '号没了',
    alternateName: 'AI 账号赛博公墓',
    url: 'https://haomeile.rip/',
    inLanguage: 'zh-CN',
    description:
      '用户匿名记录 Claude、Codex 和 Antigravity 账号被停用、受限或异常经历的独立社区网站，与产品所属厂商无关。',
  },
];
---

<SiteLayout
  title="号没了 · AI 账号赛博公墓"
  description="记录 Claude、Codex、Antigravity的账号停用、验证受阻和异常经历。匿名立碑、献花或制作墓志铭卡片，内容为用户自述，未经核实；本站与产品所属厂商无关。"
  path="/"
  current="/"
  jsonLd={jsonLd}
>
  <main>
    <HeroScene />
    <Tally />
    <Wall />
    <Timeline />
  </main>
</SiteLayout>
