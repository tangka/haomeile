---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import Tally from '../components/Tally.astro';
import Wall from '../components/Wall.astro';
import Timeline from '../components/Timeline.astro';
import { siteOrigin } from '../../shared/site';
const description =
  '查看 Claude、Codex 和 Antigravity 的封号与申诉经历，查找官方申诉入口，了解订阅扣费和套餐异常的处理步骤。';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: '号没了',
    alternateName: 'AI 账号赛博公墓',
    url: siteOrigin(import.meta.env.PUBLIC_SITE_ORIGIN) + '/',
    inLanguage: 'zh-CN',
    description,
  },
];
---

<SiteLayout
  title="号没了 · Claude、Codex、Antigravity 封号与申诉记录"
  description={description}
  path="/"
  current="/"
  jsonLd={jsonLd}
>
  <meta
    slot="head"
    name="google-site-verification"
    content="9lgbHTv4HyocsAwr2fnG1WlfT96dxd_FfHIn8H66OjY"
  />
  <meta
    slot="head"
    name="msvalidate.01"
    content="26D8BB079A2FFDEC3351C9D05B294330"
  />
  <main>
    <HeroScene />
    <Tally />
    <Wall />
    <Timeline />
  </main>
</SiteLayout>
