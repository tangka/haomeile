---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import Tally from '../components/Tally.astro';
import Wall from '../components/Wall.astro';
import Timeline from '../components/Timeline.astro';
import { siteOrigin } from '../../shared/site';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: '号没了',
    alternateName: 'AI 账号赛博公墓',
    url: siteOrigin(import.meta.env.PUBLIC_SITE_ORIGIN) + '/',
    inLanguage: 'zh-CN',
    description:
      '记录 Claude、Codex 和 Antigravity 账号经历，收录用户投稿与公开社区整理。',
  },
];
---

<SiteLayout
  title="号没了 · AI 账号赛博公墓"
  description="记录 Claude、Codex、Antigravity 账号经历。查看社区整理、匿名立碑、献花或制作墓志铭卡片。"
  path="/"
  current="/"
  jsonLd={jsonLd}
>
  <meta
    slot="head"
    name="google-site-verification"
    content="9lgbHTv4HyocsAwr2fnG1WlfT96dxd_FfHIn8H66OjY"
  />
  <main>
    <HeroScene />
    <Tally />
    <Wall />
    <Timeline />
  </main>
</SiteLayout>
