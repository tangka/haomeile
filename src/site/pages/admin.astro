---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="审核后台 · 号没了"
  description="号没了投稿、修改和举报审核后台。"
  path="/admin"
  current="/admin"
  robots="noindex,nofollow"
>
  <main class="admin">
    <div class="wrap">
      <div class="page-head">
        <h1>审核</h1>
        <p>
          标红的投稿命中了隐私或灰产规则，需要逐条看。通过后才会出现在纪念墙和统计里。
        </p>
      </div>
      <div class="tabs" role="tablist" aria-label="审核队列">
        <button
          id="tab-new"
          class="tab"
          role="tab"
          aria-selected="true"
          aria-controls="queue"
          data-queue="new"
        >
          新投稿
          <span class="badge" data-count="new">
            0
          </span>
        </button>
        <button
          id="tab-patch"
          class="tab"
          role="tab"
          aria-selected="false"
          aria-controls="queue"
          tabindex="-1"
          data-queue="patch"
        >
          修改
          <span class="badge" data-count="patch">
            0
          </span>
        </button>
        <button
          id="tab-reported"
          class="tab"
          role="tab"
          aria-selected="false"
          aria-controls="queue"
          tabindex="-1"
          data-queue="reported"
        >
          被举报
          <span class="badge" data-count="reported">
            0
          </span>
        </button>
      </div>
      <div
        id="queue"
        class="queue"
        role="tabpanel"
        aria-labelledby="tab-new"
        aria-live="polite"
        aria-busy="true"
      >
        <p>正在加载审核队列……</p>
      </div>
      <section class="log" aria-labelledby="log-title">
        <h2 id="log-title">最近的操作</h2>
        <div class="table-scroll" style="overflow-x:auto">
          <table>
            <thead>
              <tr>
                <th scope="col">时间</th>
                <th scope="col">墓碑</th>
                <th scope="col">操作</th>
                <th scope="col">操作人</th>
              </tr>
            </thead>
            <tbody id="audit-log"></tbody>
          </table>
        </div>
      </section>
    </div>
  </main>
  <script>
    import '../scripts/admin';
  </script>
</SiteLayout>
