---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="审核后台 · 号没了"
  description="号没了投稿、修改和举报审核后台。"
  path="/admin"
  current="/admin"
  robots="noindex,nofollow"
>
  <main class="admin">
    <div class="wrap">
      <div class="page-head">
        <h1>审核</h1>
        <p>
          标红的投稿命中了隐私或灰产规则，需要逐条看。通过后才会出现在纪念墙和统计里。
        </p>
      </div>
      <div class="tabs" role="tablist" aria-label="审核队列">
        <button
          id="tab-new"
          class="tab"
          role="tab"
          aria-selected="true"
          aria-controls="queue"
          data-queue="new"
        >
          新投稿
          <span class="badge" data-count="new">
            0
          </span>
        </button>
        <button
          id="tab-patch"
          class="tab"
          role="tab"
          aria-selected="false"
          aria-controls="queue"
          tabindex="-1"
          data-queue="patch"
        >
          修改
          <span class="badge" data-count="patch">
            0
          </span>
        </button>
        <button
          id="tab-reported"
          class="tab"
          role="tab"
          aria-selected="false"
          aria-controls="queue"
          tabindex="-1"
          data-queue="reported"
        >
          被举报
          <span class="badge" data-count="reported">
            0
          </span>
        </button>
      </div>
      <div
        id="queue"
        class="queue"
        role="tabpanel"
        aria-labelledby="tab-new"
        aria-live="polite"
        aria-busy="true"
      >
        <p>正在加载审核队列……</p>
      </div>
      <section id="email-capacity" class="log" aria-labelledby="capacity-title">
        <div class="capacity-head">
          <h2 id="capacity-title">雷达邮件额度</h2>
          <button class="btn btn-quiet" type="button" id="capacity-refresh">
            刷新额度
          </button>
        </div>
        <p id="capacity-summary" role="status">
          正在读取发信额度……
        </p>
        <div class="capacity-table" id="capacity-details" hidden>
          <table aria-labelledby="capacity-title">
            <thead>
              <tr>
                <th scope="col">发信渠道</th>
                <th scope="col">状态</th>
                <th scope="col">日用量 / 上限</th>
                <th scope="col">月用量 / 上限</th>
                <th scope="col">今日可发</th>
                <th scope="col">已订阅人数</th>
              </tr>
            </thead>
            <tbody id="capacity-providers"></tbody>
          </table>
        </div>
      </section>
      <section class="log" aria-labelledby="log-title">
        <h2 id="log-title">最近的操作</h2>
        <div class="table-scroll" style="overflow-x:auto">
          <table>
            <thead>
              <tr>
                <th scope="col">时间</th>
                <th scope="col">墓碑</th>
                <th scope="col">操作</th>
                <th scope="col">操作人</th>
              </tr>
            </thead>
            <tbody id="audit-log"></tbody>
          </table>
        </div>
      </section>
    </div>
  </main>
  <script>
    import '../scripts/admin';
  </script>
</SiteLayout>

<style>
  .capacity-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 16px;
  }
  .capacity-table {
    overflow-x: auto;
  }
  .capacity-table table {
    min-width: 40rem;
  }
</style>
