---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { TIP_ARTICLES, tipPageTitle } from '../../../shared/tips';

export function getStaticPaths() {
  return TIP_ARTICLES.map((tip) => ({
    params: { slug: tip.slug },
    props: { tip },
  }));
}

interface Props {
  tip: (typeof TIP_ARTICLES)[number];
}

const { tip } = Astro.props;
---

<SiteLayout
  title={tipPageTitle(tip.title.zh, 'zh')}
  description={tip.summary.zh}
  current="/tips"
  path={'/tips/' + tip.slug}
  ogType="article"
>
  <main class="page">
    <div class="wrap">
      <article class="doc tip-article">
        <nav class="tip-crumbs" aria-label="文章导航">
          <a href="/tips">返回技巧目录</a>
        </nav>
        <div class="page-head">
          <h1>{tip.title.zh}</h1>
          <p>{tip.summary.zh}</p>
        </div>
        <p>{tip.experience.zh}</p>
        <h2>操作步骤</h2>
        <ol>
          {tip.steps.map(({ text, link }) => (
            <li>
              {text.zh}
              {link && (
                <>
                  {' '}
                  <a href={link.href}>{link.label.zh}</a>
                </>
              )}
            </li>
          ))}
        </ol>
        <p class="tip-source">
          <a href={tip.source} target="_blank" rel="noopener noreferrer">
            阅读 X 长文
          </a>
          <span>{tip.sourceAuthor}</span>
          <time datetime={tip.sourceDate}>{tip.sourceDate}</time>
          <span>
            收录时浏览量{' '}
            <strong>{tip.sourceViews.toLocaleString('en-US')}</strong>
          </span>
        </p>
      </article>
    </div>
  </main>
</SiteLayout>

<style>
  .tip-source {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: baseline;
  }
  .tip-crumbs {
    margin-block-end: 22px;
    font-size: var(--fs-s);
  }
  .tip-article li + li {
    margin-block-start: 12px;
  }
  .tip-article .tip-source {
    margin-block-start: 28px;
    border-block-start: 1px solid var(--stone-shade);
    padding-block-start: 14px;
    font-size: var(--fs-s);
  }
</style>
