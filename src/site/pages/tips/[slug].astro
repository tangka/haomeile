---
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  TIP_ARTICLES,
  tipLinkHref,
  tipNext,
  tipPageTitle,
  tipPublishedTime,
  tipVendors,
  type TipVendor,
} from '../../../shared/tips';
import { siteOrigin } from '../../../shared/site';

export function getStaticPaths() {
  return TIP_ARTICLES.map((tip) => ({
    params: { slug: tip.slug },
    props: { tip },
  }));
}

interface Props {
  tip: (typeof TIP_ARTICLES)[number];
}

const SITE = siteOrigin(import.meta.env.PUBLIC_SITE_ORIGIN);
const { tip } = Astro.props;
const pageUrl = `${SITE}/tips/${tip.slug}`;
const relatedVendors = tipVendors(tip.slug);
const nextTips = tipNext(tip.slug);
const heading = tip.heading.zh;
const sourceDate = tipPublishedTime(tip.sourcePublishedAt).slice(0, 10);

const vendorMeta: Record<
  TipVendor,
  { label: string; appealLabel: string; answer?: string }
> = {
  claude: {
    answer: 'Claude Code 提示组织停用怎么办',
    label: '查看 Claude 停用案例',
    appealLabel: 'Claude 官方申诉入口',
  },
  codex: {
    answer: 'Codex 或 ChatGPT 账号被停用',
    label: '查看 Codex 停用案例',
    appealLabel: 'Codex / OpenAI 官方申诉入口',
  },
  antigravity: {
    answer: 'Antigravity 403 或服务停用怎么办',
    label: '查看 Antigravity 停用案例',
    appealLabel: 'Antigravity 官方申诉入口',
  },
};

const citations = [
  tip.source,
  ...tip.steps
    .map((step) => (step.link ? tipLinkHref(step.link.href, 'zh') : null))
    .filter((href): href is string => Boolean(href)),
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: heading,
    description: tip.summary.zh,
    inLanguage: 'zh-CN',
    url: pageUrl,
    datePublished: tip.publishedAt,
    dateModified: tip.modifiedAt,
    author: {
      '@type': 'Organization',
      name: '号没了',
      url: SITE + '/',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Haomeile',
      url: SITE + '/',
    },
    isBasedOn: {
      '@type': 'CreativeWork',
      url: tip.source,
      author: { '@type': 'Person', name: tip.sourceAuthor },
      datePublished: tip.sourcePublishedAt,
    },
    citation: citations,
    step: tip.steps.map((step, index) => ({
      '@type': 'HowToStep',
      position: index + 1,
      text: step.text.zh,
      ...(step.link ? { url: tipLinkHref(step.link.href, 'zh') } : {}),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '纪念墙',
        item: SITE + '/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: '使用小技巧',
        item: SITE + '/tips',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: heading,
      },
    ],
  },
];
---

<SiteLayout
  title={tipPageTitle(heading, 'zh')}
  description={tip.summary.zh}
  current="/tips"
  path={'/tips/' + tip.slug}
  ogType="article"
  publishedTime={tip.publishedAt}
  modifiedTime={tip.modifiedAt}
  jsonLd={jsonLd}
>
  <main class="page">
    <div class="wrap">
      <article class="doc tip-article">
        <nav class="tip-crumbs" aria-label="文章导航">
          <a href="/tips">返回技巧目录</a>
        </nav>
        <div class="page-head">
          <h1>{heading}</h1>
          <p>{tip.summary.zh}</p>
        </div>
        <p class="tip-provenance">
          {`本站根据 ${tip.sourceAuthor} 于 ${sourceDate} 发布的原文整理，非原文作者撰写。`}
          <a href={tip.source} target="_blank" rel="noopener noreferrer">
            查看原文
          </a>
        </p>
        <p>{tip.experience.zh}</p>
        <h2>操作步骤</h2>
        <ol>
          {tip.steps.map(({ text, link }) => (
            <li>
              {text.zh}
              {link && (
                <>
                  {' '}
                  <a
                    href={tipLinkHref(link.href, 'zh')}
                    data-en-href={
                      typeof link.href === 'string' ? undefined : link.href.en
                    }
                  >
                    {link.label.zh}
                  </a>
                </>
              )}
            </li>
          ))}
        </ol>
        <section class="tip-next" aria-labelledby="tip-next-title">
          <h2 id="tip-next-title">接着看</h2>
          <ul>
            {nextTips.map((next) => (
              <li>
                <a href={'/tips/' + next.slug}>{next.heading.zh}</a>
              </li>
            ))}
            <li>
              <a href="/radar">额度什么时候可能重置</a>
            </li>
          </ul>
        </section>
        <p class="tip-source">
          <a href={tip.source} target="_blank" rel="noopener noreferrer">
            阅读 X 长文
          </a>
          <span>{tip.sourceAuthor}</span>
          <time datetime={tip.sourcePublishedAt} title="UTC+8">
            {tipPublishedTime(tip.sourcePublishedAt)}
          </time>
          {!tip.hideSourceTitle && (
            <span class="tip-original-title" lang="zh-CN" translate="no">
              《{tip.sourceTitle}》
            </span>
          )}
        </p>
        <nav class="tip-related" aria-label="相关入口">
          {relatedVendors.map((vendor) => (
            <>
              {vendorMeta[vendor].answer && (
                <a href={'/v/' + vendor + '#answer'}>
                  {vendorMeta[vendor].answer}
                </a>
              )}
              <a href={'/v/' + vendor}>{vendorMeta[vendor].label}</a>
              <a href={'/appeal#' + vendor}>{vendorMeta[vendor].appealLabel}</a>
            </>
          ))}
          {relatedVendors.length === 0 && <a href="/appeal">官方申诉入口</a>}
        </nav>
      </article>
    </div>
  </main>
</SiteLayout>

<style>
  .tip-article {
    margin-inline: auto;
  }
  .tip-source {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: baseline;
  }
  .tip-provenance {
    font-size: var(--fs-s);
  }
  .tip-crumbs {
    margin-block-end: 22px;
    font-size: var(--fs-s);
  }
  .tip-article li + li {
    margin-block-start: 12px;
  }
  .tip-article .tip-source {
    margin-block-start: 28px;
    border-block-start: 1px solid var(--stone-shade);
    padding-block-start: 14px;
    font-size: var(--fs-s);
  }
  .tip-next ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 10px;
    padding: 0;
    list-style: none;
  }
  .tip-next li + li {
    margin-block-start: 0;
  }
  .tip-next a {
    display: block;
    height: 100%;
    padding: 10px 12px;
    border: 2px solid var(--ink);
    font-size: var(--fs-s);
    text-decoration: none;
  }
  .tip-next a:hover,
  .tip-next a:focus-visible {
    background: var(--ink);
    color: var(--paper);
  }
  .tip-related {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-block-start: 16px;
    font-size: var(--fs-s);
  }
</style>
