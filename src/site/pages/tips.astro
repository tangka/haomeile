---
import SiteLayout from '../layouts/SiteLayout.astro';

import { TIP_ARTICLES } from '../../shared/tips';
import { LABELS } from '../scripts/labels';

const groups = Object.entries(LABELS.vendor).map(([id, name]) => ({
  id,
  name,
  tips: TIP_ARTICLES.filter((tip) => tip.product === id),
}));
---

<SiteLayout
  title="使用小技巧 · 号没了"
  description="从 X 整理的 Claude、Codex 和 Antigravity 账号技巧，覆盖注册、验证和停用申诉。"
  path="/tips"
>
  <main class="page">
    <div class="wrap">
      <div class="page-head">
        <h1>使用小技巧</h1>
      </div>
      {groups.map(({ id, name, tips }) => (
        <section class="tip-group" aria-labelledby={id}>
          <h2 id={id}>{name}</h2>
          <ul class="tips">
            {tips.map((tip) => (
              <li>
                <a class="tip-preview" href={'/tips/' + tip.slug}>
                  <h3>{tip.title.zh}</h3>
                  <span class="tip-topic">{tip.topic.zh}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
</SiteLayout>

<style>
  .tip-group + .tip-group {
    margin-block-start: 30px;
  }
  .tip-group h2 {
    margin: 0 0 10px;
    font-family: var(--font-carve);
    font-size: var(--fs-l);
  }
  .tips {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--stone-shade);
  }
  .tip-preview {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px 16px;
    min-height: 52px;
    padding: 10px 6px;
    border-block-end: 1px solid var(--stone-shade);
    font-size: var(--fs-s);
    text-decoration: none;
  }
  .tips h3 {
    margin: 0;
    font-size: var(--fs-s);
    overflow-wrap: anywhere;
  }
  .tip-preview:hover h3 {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .tip-topic {
    font-size: var(--fs-xs);
    color: var(--stone-ink);
    background: var(--stone);
    padding: 2px 7px;
  }
</style>
