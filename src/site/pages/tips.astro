---
import SiteLayout from '../layouts/SiteLayout.astro';
import { TIP_ARTICLES, tipPublishedTime } from '../../shared/tips';
import { siteOrigin } from '../../shared/site';

const SITE = siteOrigin(import.meta.env.PUBLIC_SITE_ORIGIN);
const tips = [...TIP_ARTICLES].sort((a, b) =>
  b.sourcePublishedAt.localeCompare(a.sourcePublishedAt),
);

const description =
  '面向中文读者的 Claude、ChatGPT 和 Google AI 开通与订阅指南，涵盖付款、续费和套餐异常排查。';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'AI 账号开通、订阅与扣费排查',
    description,
    url: SITE + '/tips',
    inLanguage: 'zh-CN',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: tips.map((tip, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: tip.title,
        url: SITE + '/tips/' + tip.slug,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '纪念墙',
        item: SITE + '/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: '使用小技巧',
      },
    ],
  },
];
---

<SiteLayout
  title="AI 账号开通、订阅与扣费排查 · 号没了"
  description={description}
  path="/tips"
  jsonLd={jsonLd}
>
  <main class="page">
    <div class="wrap">
      <div class="page-head">
        <h1>使用小技巧</h1>
      </div>
      <ul class="tips">
        {tips.map((tip) => (
          <li>
            <a
              class="tip-preview"
              href={'/tips/' + tip.slug}
              aria-labelledby={'tip-title-' + tip.slug}
            >
              <span id={'tip-title-' + tip.slug} class="tip-title">
                {tip.title}
              </span>
              <time datetime={tip.sourcePublishedAt} title="UTC+8">
                {tipPublishedTime(tip.sourcePublishedAt)}
              </time>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</SiteLayout>

<style>
  .tips {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--stone-shade);
  }
  .tip-preview {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 10px 6px;
    border-block-end: 1px solid var(--stone-shade);
    font-size: var(--fs-s);
    text-decoration: none;
  }
  .tip-title {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .tip-preview:is(:hover, :focus-visible) .tip-title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .tip-preview time {
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    text-align: end;
    white-space: nowrap;
    opacity: 0.8;
  }
  @media (max-width: 520px) {
    .tip-preview time {
      max-inline-size: 10ch;
      white-space: normal;
    }
  }
</style>
