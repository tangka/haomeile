---
import SiteLayout from '../layouts/SiteLayout.astro';

const groups = [
  {
    id: 'claude',
    name: 'Claude',
    tips: [
      {
        title: '把常用要求存进项目',
        body: '打开 Claude 项目，选择 Set project instructions，保存常用格式、术语和要求。同一项目里的新对话会沿用这些指令。',
        url: 'https://support.claude.com/en/articles/9519177-how-can-i-create-and-manage-projects',
      },
      {
        title: '改代码前先看方案',
        body: '在项目目录用下面的命令启动 Claude Code。先核对它列出的改动范围和验证步骤，再批准实施。',
        command: 'claude --permission-mode plan',
        url: 'https://code.claude.com/docs/en/common-workflows#plan-before-editing',
      },
    ],
  },
  {
    id: 'codex',
    name: 'Codex',
    tips: [
      {
        title: '用 Worktree 并行开发',
        body: '在本地 Git 项目里新建 Codex 任务时，选择 Worktree。比如一个任务修登录，另一个改页面，各自在独立工作树里修改。',
        url: 'https://learn.chatgpt.com/docs/environments/git-worktrees',
      },
      {
        title: '提交前审查当前改动',
        body: '在仓库目录运行下面的命令，让 Codex 审查待提交、未暂存和未跟踪的改动。先处理报告里的问题，再提交。',
        command: 'codex review --uncommitted',
        url: 'https://learn.chatgpt.com/docs/developer-commands#codex-review',
      },
    ],
  },
  {
    id: 'antigravity',
    name: 'Antigravity',
    tips: [
      {
        title: '把项目约定写进 AGENTS.md',
        body: '在项目根目录的 AGENTS.md 写下测试命令、目录约定和代码风格。Antigravity 会自动读取这些项目指令。',
        url: 'https://antigravity.google/docs/rules/',
      },
      {
        title: '用 /browser 验收手机布局',
        body: '启动本地开发站点，在 Antigravity App 里用 /browser 打开它。请它切到 390 像素宽，分别截下导航菜单展开和收起的样子。',
        url: 'https://antigravity.google/docs/commands/browser/',
      },
    ],
  },
];
---

<SiteLayout
  title="使用小技巧 · 号没了"
  description="Claude、Codex 和 Antigravity 的项目设置、代码审查和页面验收技巧。"
  path="/tips"
>
  <main class="page">
    <div class="wrap">
      <div class="page-head">
        <h1>使用小技巧</h1>
      </div>
      <nav class="tips-index" aria-label="按产品查看">
        {groups.map(({ id, name }) => (
          <a class="btn" href={'#' + id}>
            {name}
          </a>
        ))}
      </nav>
      {groups.map(({ id, name, tips }) => (
        <section class="tip-group" aria-labelledby={id}>
          <h2 id={id}>{name}</h2>
          <ul class="tips">
            {tips.map((tip) => (
              <li>
                <h3>{tip.title}</h3>
                <p>{tip.body}</p>
                {'command' in tip && <code>{tip.command}</code>}
                <a href={tip.url} target="_blank" rel="noopener noreferrer">
                  官方文档
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
</SiteLayout>

<style>
  .tips-index {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-block-end: 32px;
  }
  .tip-group + .tip-group {
    margin-block-start: 30px;
  }
  .tip-group h2 {
    margin: 0 0 10px;
    font-family: var(--font-carve);
    font-size: var(--fs-l);
  }
  .tips {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tips li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 16px;
    border: 2px solid var(--ink);
    font-size: var(--fs-s);
  }
  .tips h3,
  .tips p {
    margin: 0;
  }
  .tips h3 {
    font-size: var(--fs-m);
  }
  .tips code {
    max-width: 100%;
    padding: 4px 8px;
    background: var(--stone);
    color: var(--stone-ink);
    overflow-wrap: anywhere;
  }
  .tips li > a {
    margin-block-start: auto;
  }
</style>
