---
import SiteLayout from '../layouts/SiteLayout.astro';

import { TIP_ARTICLES } from '../../shared/tips';
import { LABELS } from '../scripts/labels';

const groups = Object.entries(LABELS.vendor).map(([id, name]) => ({
  id,
  name,
  tips: TIP_ARTICLES.filter((tip) => tip.product === id),
}));
---

<SiteLayout
  title="使用小技巧 · 号没了"
  description="从 X 整理的 Claude、Codex 和 Antigravity 账号技巧，覆盖注册、验证和停用申诉。"
  path="/tips"
>
  <main class="page">
    <div class="wrap">
      <div class="page-head">
        <h1>使用小技巧</h1>
      </div>
      <nav class="tips-index" aria-label="按产品查看">
        {groups.map(({ id, name }) => (
          <a class="btn" href={'#' + id}>
            {name}
          </a>
        ))}
      </nav>
      {groups.map(({ id, name, tips }) => (
        <section class="tip-group" aria-labelledby={id}>
          <h2 id={id}>{name}</h2>
          <ul class="tips">
            {tips.map((tip) => (
              <li>
                <a class="tip-preview" href={'/tips/' + tip.slug}>
                  <span class="tip-topic">{tip.topic.zh}</span>
                  <h3>{tip.title.zh}</h3>
                  <p>{tip.summary.zh}</p>
                  <span class="tip-read">查看文章</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
</SiteLayout>

<style>
  .tips-index {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-block-end: 32px;
  }
  .tip-group + .tip-group {
    margin-block-start: 30px;
  }
  .tip-group h2 {
    margin: 0 0 10px;
    font-family: var(--font-carve);
    font-size: var(--fs-l);
  }
  .tips {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tip-preview {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 16px;
    border: 2px solid var(--ink);
    font-size: var(--fs-s);
    height: 100%;
    text-decoration: none;
  }
  .tips h3,
  .tips p {
    margin: 0;
  }
  .tips h3 {
    font-size: var(--fs-m);
  }
  .tip-preview:hover h3,
  .tip-read {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .tip-read {
    margin-block-start: auto;
    font-weight: 600;
  }
  .tip-topic {
    font-size: var(--fs-xs);
    color: var(--stone-ink);
    background: var(--stone);
    padding: 2px 7px;
  }
</style>
