---
import SiteLayout from '../layouts/SiteLayout.astro';
import { TIP_ARTICLES } from '../../shared/tips';

const tips = [...TIP_ARTICLES].sort((a, b) =>
  b.sourceDate.localeCompare(a.sourceDate),
);
---

<SiteLayout
  title="使用小技巧 · 号没了"
  description="面向中国用户的账号开通长文，覆盖 Claude、ChatGPT 与 Google AI 的注册、付款和订阅确认。"
  path="/tips"
>
  <main class="page">
    <div class="wrap">
      <div class="page-head">
        <h1>使用小技巧</h1>
      </div>
      <ul class="tips">
        {tips.map((tip) => (
          <li>
            <a class="tip-preview" href={'/tips/' + tip.slug}>
              {tip.title.zh}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</SiteLayout>

<style>
  .tips {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--stone-shade);
  }
  .tip-preview {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 10px 6px;
    border-block-end: 1px solid var(--stone-shade);
    font-size: var(--fs-s);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .tip-preview:is(:hover, :focus-visible) {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
