---
import SiteLayout from '../layouts/SiteLayout.astro';
import RadarMark from '../components/RadarMark.astro';
import { RADAR_PLATFORM_NAMES } from '../../shared/radar';
import { siteOrigin } from '../../shared/site';

const SITE = siteOrigin(import.meta.env.PUBLIC_SITE_ORIGIN);
const subtitle =
  'Codex、Claude Code 和 Antigravity 在未来 24 小时内发生额外额度重置的概率。';
const description =
  '查看 Codex、Claude Code 和 Antigravity 未来 24 小时额外重置概率预测与近 24 小时趋势，支持超过 80% 时发送免费邮件提醒，附各平台停用案例与官方申诉入口。';

const faqs = [
  {
    question: '重置雷达的概率预测怎么看？是否代表厂商官方公告？',
    answer:
      '重置雷达每 30 分钟按社区观测信号刷新一次，展示 Codex、Claude Code 和 Antigravity 未来 24 小时发生额外重置的概率参考及近 24 小时变化趋势，不代表厂商官方通知。',
  },
  {
    question: '怎么在 Codex、Claude Code 或 Antigravity 额度重置概率升高时收到提醒？',
    answer:
      '点击页面上的「订阅邮件提醒」，勾选关注的平台并填写邮箱，输入邮件里的 6 位验证码（或点击确认链接）即可生效。所选平台的额外重置概率超过 80% 时会自动发邮件，连续高于 80% 期间每个平台只提醒一次，且可随时通过邮件链接退订。',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: '重置雷达：Codex、Claude Code、Antigravity 24 小时额外重置概率',
    description,
    url: SITE + '/radar',
    inLanguage: 'zh-CN',
    creator: {
      '@type': 'Organization',
      name: 'Haomeile',
      url: SITE + '/',
    },
    variableMeasured: [
      'Codex 24-hour extra quota reset probability',
      'Claude Code 24-hour extra quota reset probability',
      'Antigravity 24-hour extra quota reset probability',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'zh-CN',
    mainEntity: faqs.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '纪念墙',
        item: SITE + '/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: '重置雷达',
      },
    ],
  },
];
---

<SiteLayout
  title="重置雷达：Codex、Claude Code、Antigravity 24 小时额外重置概率 · 号没了"
  description={description}
  path="/radar"
  jsonLd={jsonLd}
>
  <main class="page radar-page">
    <div class="wrap">
      <header class="radar-intro">
        <div class="radar-intro-copy">
          <h1>重置雷达</h1>
          <p>{subtitle}</p>
          <div class="radar-cta" data-radar-email-cta data-state="loading">
            <button
              class="btn btn-primary radar-subscribe"
              type="button"
              aria-haspopup="dialog"
              aria-controls="radar-email-dialog"
              data-ssr="radar-email-signup"
              hidden
            >
              订阅邮件提醒
            </button>
            <span class="radar-cta-hint">
              预测超过 80% 自动发邮件提醒，免费且可随时退订
            </span>
            <strong data-radar-email-subscribed tabindex="-1" hidden>已订阅</strong>
            <button
              class="btn btn-quiet"
              type="button"
              data-radar-email-edit-subscription
              aria-haspopup="dialog"
              aria-controls="radar-email-dialog"
              hidden
            >修改订阅</button>
          </div>
          <p data-radar-email-notice role="status"></p>
        </div>
        <div class="radar-intro-mark" aria-hidden="true">
          <RadarMark />
        </div>
      </header>

      <section class="radar-vitals" aria-labelledby="radar-forecast-title">
        <h2 id="radar-forecast-title" class="visually-hidden">
          重置预测
        </h2>
        <div data-ssr="radar-overview">
          <p class="radar-updated">暂未获取到额度重置预测。</p>
        </div>
      </section>

      <section
        class="radar-history"
        data-ssr="radar-history"
        aria-labelledby="radar-trend-title"
        hidden
      >
        <div class="radar-history-head">
          <h2 id="radar-trend-title">近 24 小时额外重置趋势</h2>
          <p>每 30 分钟一轮</p>
        </div>
        <ul class="radar-trend-legend" data-radar-trend-legend></ul>
        <canvas
          data-radar-trend=""
          role="img"
          aria-label="额外重置概率趋势图"
          aria-describedby="radar-trend-help"
          tabindex="0"
        ></canvas>
        <p
          data-radar-trend-readout
          class="radar-trend-readout"
          role="status"
        ></p>
        <p id="radar-trend-help" class="radar-trend-help">
          指向、轻点或用方向键查看采样点。
        </p>
      </section>

      <dialog
        id="radar-email-dialog"
        class="sheet radar-email"
        aria-labelledby="radar-email-title"
      >
        <div class="sheet-in">
          <div class="radar-email-head">
            <h2 id="radar-email-title" tabindex="-1" autofocus>
              订阅邮件提醒
            </h2>
            <form method="dialog">
              <button
                class="btn radar-email-close"
                type="submit"
                aria-label="关闭"
              >
                ×
              </button>
            </form>
          </div>
          <p>
            所选平台的额外重置概率超过 80% 时发邮件。连续高于 80%
            期间，每个平台只提醒一次。
          </p>
          <form class="form" method="post" data-radar-email-signup>
            <fieldset class="field">
              <legend>选择提醒的平台</legend>
              <div class="seg">
                {Object.entries(RADAR_PLATFORM_NAMES).map(([id, name]) => (
                  <label data-radar-platform={id}>
                    <input type="checkbox" name="platform" value={id} />
                    {name}
                  </label>
                ))}
              </div>
            </fieldset>
            <div class="field">
              <label for="radar-email-address">邮箱地址</label>
              <input
                class="input"
                id="radar-email-address"
                name="email"
                type="email"
                autocomplete="email"
                aria-describedby="radar-email-help"
                maxlength="254"
                required
              />
              <p class="hint" id="radar-email-help">
                验证邮箱后开始接收提醒，可随时退订。
                <a href="/privacy#radar-email">查看邮件数据说明</a>
              </p>
            </div>
            <div class="actions">
              <button class="btn btn-primary" type="submit">
                订阅
              </button>
            </div>
          </form>
          <form class="form" method="post" data-radar-email-verify hidden>
            <div class="field">
              <label for="radar-email-code">邮箱验证码</label>
              <input
                class="input"
                id="radar-email-code"
                name="code"
                type="text"
                inputmode="numeric"
                autocomplete="one-time-code"
                pattern="[0-9]{6}"
                maxlength="6"
                aria-describedby="radar-code-help radar-email-status"
                required
              />
              <p class="hint" id="radar-code-help">
                请输入邮件里的 6 位验证码，10
                分钟内有效。也可以点击邮件中的确认链接。
              </p>
            </div>
            <div class="actions">
              <button class="btn btn-primary" type="submit">
                确认订阅
              </button>
              <button class="btn" type="button" data-edit-email>
                修改邮箱或重新获取验证码
              </button>
            </div>
          </form>
          <p
            id="radar-email-status"
            class="radar-email-status"
            role="status"
            tabindex="-1"
            data-radar-email-status
          ></p>
          <div class="actions" data-radar-email-duplicate-actions hidden>
            <button class="btn" type="button" data-radar-email-manage-existing>
              修改订阅
            </button>
            <button
              class="btn btn-quiet"
              type="button"
              data-radar-email-other-address
            >
              使用其他邮箱
            </button>
          </div>
        </div>
      </dialog>

      <section class="radar-notes" aria-labelledby="radar-notes-title">
        <h2 id="radar-notes-title">说明与相关入口</h2>
        <p>
          百分比表示基于社区观测信号的未来 24
          小时额外重置概率参考，不代表厂商官方通知。订阅邮件提醒后，所选平台预测超过
          80% 时会自动发信通知，连续高于 80% 期间每个平台只提醒一次。
        </p>
        <nav class="radar-links" aria-label="相关入口">
          <a href="/v/codex">查看 Codex 停用案例</a>
          <a href="/v/claude">查看 Claude 停用案例</a>
          <a href="/v/antigravity">查看 Antigravity 停用案例</a>
          <a href="/appeal">官方申诉入口</a>
          <a href="/tips">使用小技巧</a>
          <a href="/privacy#radar-email">邮件提醒隐私说明</a>
        </nav>
      </section>
    </div>
  </main>
  <script>
    import '../scripts/radar-trend';
    import '../scripts/radar-email';
  </script>
</SiteLayout>

<style>
  .radar-page {
    padding-top: clamp(18px, 5vw, 54px);
  }

  /* Match the Reset Radar mini program's probability-history palette. */
  .radar-page :global([data-radar-platform='codex']) {
    --platform-accent: #6f76f6;
  }

  .radar-page :global([data-radar-platform='claude']) {
    --platform-accent: light-dark(#d16e4b, #de7753);
  }

  .radar-page :global([data-radar-platform='antigravity']) {
    --platform-accent: #4285f4;
  }

  .radar-intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(20px, 5vw, 48px);
    border: 2px solid var(--sky-ink);
    background: var(--sky);
    color: var(--sky-ink);
    box-shadow: 5px 5px 0 var(--sky-ink);
  }

  .radar-intro-copy {
    min-width: 0;
  }

  h1 {
    margin: 0 0 10px;
    font: 900 clamp(34px, 6vw, 60px) / 1.12 var(--font-carve);
  }

  p {
    margin: 0;
  }

  .radar-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 18px;
  }

  .radar-cta[data-state='loading'] {
    visibility: hidden;
  }

  .radar-cta[data-state='loading']:has([data-ssr='radar-email-signup'][hidden]),
  .radar-cta[data-state='subscribed'] .radar-cta-hint {
    display: none;
  }

  .radar-cta-hint {
    font-size: var(--fs-xs);
    opacity: 0.86;
  }

  [data-radar-email-notice]:not(:empty) {
    margin-top: 8px;
  }

  .radar-intro-mark {
    --radar-mark-size: clamp(64px, 11vw, 126px);
    flex: none;
    display: grid;
    place-items: center;
  }

  .radar-subscribe {
    font-weight: 700;
  }

  .radar-vitals {
    margin-top: 24px;
  }

  .radar-vitals :global(.radar-forecasts) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .radar-vitals :global(.radar-forecasts li) {
    display: grid;
    gap: 10px;
    padding: clamp(14px, 2.5vw, 24px);
    border: 2px solid var(--ink);
    border-top: 5px solid var(--platform-accent);
    background: var(--paper);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .radar-vitals :global(.radar-forecasts h3) {
    margin: 0;
    font-size: var(--fs-s);
  }

  .radar-vitals :global(.radar-forecasts strong) {
    font-size: clamp(32px, 6vw, 54px);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .radar-vitals :global(.radar-bar) {
    height: 8px;
    border: 1.5px solid var(--ink);
    background: var(--paper);
    overflow: hidden;
  }

  .radar-vitals :global(.radar-bar span) {
    display: block;
    height: 100%;
    background: var(--platform-accent);
  }

  .radar-vitals :global(.radar-sub) {
    font-size: var(--fs-xs);
    opacity: 0.78;
  }

  .radar-vitals :global(.radar-updated) {
    margin: 14px 0 0;
    font-size: var(--fs-xs);
    opacity: 0.82;
  }

  .radar-history {
    margin-top: 24px;
    border: 2px solid var(--ink);
    background: var(--paper);
    box-shadow: 4px 4px 0 var(--ink);
    padding: clamp(14px, 3vw, 24px);
  }

  .radar-notes {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--stone-shade);
    display: grid;
    gap: 10px;
  }

  .radar-notes h2 {
    margin: 0;
    font-size: var(--fs-m);
    font-family: var(--font-carve);
  }

  .radar-notes p {
    font-size: var(--fs-s);
    opacity: 0.88;
  }

  .radar-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin-top: 4px;
    font-size: var(--fs-xs);
  }

  .radar-links a {
    padding: 5px 10px;
    border: 1.5px solid var(--ink);
    text-decoration: none;
  }

  .radar-links a:hover,
  .radar-links a:focus-visible {
    background: var(--ink);
    color: var(--paper);
  }

  .radar-history-head,
  .radar-trend-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
  }

  .radar-email {
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  :global(html:has(#radar-email-dialog[open])) {
    overflow: hidden;
  }

  .radar-email-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .radar-email h2 {
    margin: 0;
  }

  .radar-email-close {
    min-width: 44px;
    padding: 0;
    font-size: 24px;
    line-height: 1;
  }

  .radar-email .form {
    gap: 14px;
    margin-top: 16px;
  }

  [data-radar-email-duplicate-actions] {
    margin-top: 14px;
  }

  .radar-email .seg label {
    transition: background-color 100ms ease, color 100ms ease;
  }

  .radar-email .seg label:has(input:checked) {
    background: color-mix(in srgb, var(--platform-accent) 12%, var(--paper));
    color: var(--ink);
    border-color: var(--platform-accent);
  }

  .radar-email .seg input {
    accent-color: var(--platform-accent);
  }

  .radar-email #radar-email-code {
    letter-spacing: 0.32em;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    font-size: var(--fs-l);
    text-align: center;
  }

  .radar-email-status:empty {
    display: none;
  }

  .radar-email-status {
    margin-top: 14px;
    padding: 10px 12px;
    border-inline-start: 4px solid var(--grass-deep);
    background: color-mix(in srgb, var(--stone) 60%, transparent);
    font-size: var(--fs-s);
    overflow-wrap: anywhere;
  }

  @media (max-width: 580px) {
    .radar-intro {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 14px;
    }

    .radar-intro-copy {
      display: contents;
    }

    .radar-intro-copy h1 {
      grid-column: 1;
    }

    .radar-intro-copy > p {
      grid-column: 1;
    }

    .radar-intro-mark {
      grid-column: 2;
      grid-row: 1 / span 2;
      --radar-mark-size: 64px;
    }

    .radar-cta {
      grid-column: 1 / -1;
      margin-top: 6px;
    }

    .radar-subscribe {
      width: 100%;
    }
  }

  .radar-history-head {
    justify-content: space-between;
  }

  .radar-history h2 {
    margin: 0;
    font-size: var(--fs-l);
    font-family: var(--font-carve);
  }

  .radar-trend-legend {
    list-style: none;
    padding: 0;
    margin: 10px 0 6px;
  }

  .radar-trend-legend :global(li)::before {
    content: '';
    display: inline-block;
    width: 14px;
    height: 3px;
    margin-inline-end: 6px;
    vertical-align: middle;
    background: var(--platform-accent);
  }

  .radar-trend-legend :global([data-radar-event])::before {
    width: 0;
    height: 1em;
    border-left: 2px dashed var(--platform-accent);
    background: transparent;
  }

  canvas {
    display: block;
    width: 100%;
    height: clamp(188px, 35vw, 312px);
  }

  .radar-history-head p,
  .radar-trend-legend,
  .radar-trend-readout,
  .radar-trend-help {
    font-size: var(--fs-xs);
  }

  .radar-trend-readout {
    min-height: 1.6em;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 450px) {
    .radar-vitals :global(.radar-forecasts) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .radar-vitals :global(.radar-forecasts li:only-child),
    .radar-vitals :global(.radar-forecasts li:nth-child(3):last-child) {
      grid-column: 1 / -1;
    }
  }
</style>
