---
import SiteLayout from '../layouts/SiteLayout.astro';

const description =
  '查看 Codex 和 Claude Code 未来 24 小时的额度重置概率，扫码进入重置雷达小程序。';
const codeImage = '/assets/reset-radar-qr.jpg';
---

<SiteLayout title="重置雷达 · 号没了" description={description} path="/radar">
  <main class="page">
    <div class="wrap">
      <div class="page-head">
        <h1>重置雷达</h1>
      </div>
      <section class="radar-vitals" aria-labelledby="radar-forecast-title">
        <h2 id="radar-forecast-title">未来 24 小时额度重置概率</h2>
        <p>根据公开信号估算。</p>
        <div data-ssr="radar-overview">
          <p class="radar-updated">暂未获取到额度重置预测。</p>
        </div>
      </section>
      <section class="radar-entry" aria-labelledby="radar-entry-title">
        <div>
          <h2 id="radar-entry-title">在微信查看研判依据</h2>
          <p>用微信扫码，或在微信小程序里搜索「重置雷达」。</p>
        </div>
        <a class="radar-code" href={codeImage} aria-label="查看小程序码原图">
          <img
            src={codeImage}
            alt="重置雷达微信小程序码"
            width="430"
            height="430"
          />
        </a>
      </section>
    </div>
  </main>
</SiteLayout>

<style>
  .radar-vitals {
    margin-bottom: 28px;
  }

  h2 {
    margin: 0 0 8px;
    font-family: var(--font-carve);
    font-size: var(--fs-l);
    line-height: 1.3;
  }

  p {
    margin: 0;
  }

  .radar-vitals > p,
  .radar-vitals :global(.radar-updated) {
    font-size: var(--fs-s);
  }

  .radar-vitals :global(.radar-forecasts) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 12px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .radar-vitals :global(.radar-forecasts li) {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 14px 16px;
    border: 2px solid var(--ink);
  }

  .radar-vitals :global(.radar-forecasts h3) {
    margin: 0;
    font-size: var(--fs-m);
  }

  .radar-vitals :global(.radar-forecasts strong) {
    font-size: var(--fs-xl);
    font-variant-numeric: tabular-nums;
    line-height: 1.25;
  }

  .radar-vitals :global(.radar-updated) {
    margin-top: 12px;
  }

  .radar-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 10rem;
    align-items: center;
    gap: clamp(24px, 5vw, 56px);
    max-width: 52rem;
    padding: clamp(20px, 3vw, 32px);
    border: 2px solid var(--ink);
    background: var(--sky);
    color: var(--sky-ink);
  }

  .radar-code {
    display: block;
    width: min(10rem, 100%);
    border: 2px solid var(--ink);
    background: white;
    box-shadow: var(--px) var(--px) 0 var(--ink);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 640px) {
    .radar-entry {
      grid-template-columns: 1fr;
    }
  }
</style>
