---
import SiteLayout from '../layouts/SiteLayout.astro';
import RadarMark from '../components/RadarMark.astro';
import { siteOrigin } from '../../shared/site';

const SITE = siteOrigin(import.meta.env.PUBLIC_SITE_ORIGIN);
const subtitle =
  'Codex、Claude Code 和 Antigravity 未来 24 小时的额度重置概率。';
const description =
  '查看 Codex、Claude Code 和 Antigravity 未来 24 小时额度重置概率预测与近 24 小时趋势，附各平台停用案例与官方申诉入口。';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: '重置雷达：Codex、Claude Code、Antigravity 24 小时额度重置概率',
    description,
    url: SITE + '/radar',
    inLanguage: 'zh-CN',
    creator: {
      '@type': 'Organization',
      name: 'Haomeile',
      url: SITE + '/',
    },
    variableMeasured: [
      'Codex 24-hour quota reset probability',
      'Claude Code 24-hour quota reset probability',
      'Antigravity 24-hour quota reset probability',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '纪念墙',
        item: SITE + '/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: '重置雷达',
      },
    ],
  },
];
---

<SiteLayout
  title="重置雷达：Codex、Claude Code、Antigravity 24 小时额度重置概率 · 号没了"
  description={description}
  path="/radar"
  jsonLd={jsonLd}
>
  <main class="page radar-page">
    <div class="wrap">
      <header class="radar-intro">
        <div>
          <h1>重置雷达</h1>
          <p>{subtitle}</p>
        </div>
        <div class="radar-intro-mark">
          <RadarMark />
        </div>
      </header>

      <section class="radar-vitals" aria-labelledby="radar-forecast-title">
        <h2 id="radar-forecast-title" class="visually-hidden">
          重置预测
        </h2>
        <div data-ssr="radar-overview">
          <p class="radar-updated">暂未获取到额度重置预测。</p>
        </div>
      </section>

      <section
        class="radar-history"
        data-ssr="radar-history"
        aria-labelledby="radar-trend-title"
        hidden
      >
        <div class="radar-history-head">
          <h2 id="radar-trend-title">近 24 小时趋势</h2>
          <p>每 30 分钟一轮</p>
        </div>
        <ul class="radar-trend-legend" data-radar-trend-legend></ul>
        <canvas
          data-radar-trend=""
          role="img"
          aria-label="额度重置概率趋势图"
          aria-describedby="radar-trend-help"
          tabindex="0"
        ></canvas>
        <p
          data-radar-trend-readout
          class="radar-trend-readout"
          role="status"
        ></p>
        <p id="radar-trend-help" class="radar-trend-help">
          指向、轻点或用方向键查看采样点。
        </p>
      </section>

      <section class="radar-notes" aria-labelledby="radar-notes-title">
        <h2 id="radar-notes-title">说明与相关入口</h2>
        <p>
          百分比表示基于社区观测信号的未来 24 小时额度重置概率参考，不代表厂商官方通知。
        </p>
        <nav class="radar-links" aria-label="相关入口">
          <a href="/v/codex">查看 Codex 停用案例</a>
          <a href="/v/claude">查看 Claude 停用案例</a>
          <a href="/v/antigravity">查看 Antigravity 停用案例</a>
          <a href="/appeal">官方申诉入口</a>
          <a href="/tips">使用小技巧</a>
        </nav>
      </section>
    </div>
  </main>
  <script>
    import '../scripts/radar-trend';
  </script>
</SiteLayout>

<style>
  .radar-page {
    padding-top: clamp(18px, 5vw, 54px);
  }

  .radar-intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: clamp(20px, 5vw, 52px);
    border: 2px solid var(--sky-ink);
    background: var(--sky);
    color: var(--sky-ink);
    box-shadow: 5px 5px 0 var(--sky-ink);
  }

  h1 {
    margin: 0 0 10px;
    font: 900 clamp(34px, 6vw, 64px) / 1.12 var(--font-carve);
  }

  p {
    margin: 0;
  }

  .radar-intro-mark {
    --radar-mark-size: clamp(52px, 11vw, 130px);
    flex: none;
  }

  .radar-vitals {
    margin-top: 24px;
  }

  .radar-vitals :global(.radar-forecasts) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .radar-vitals :global(.radar-forecasts li) {
    --card-accent: var(--grass-deep);
    display: grid;
    gap: 10px;
    padding: clamp(14px, 2.5vw, 24px);
    border: 2px solid var(--ink);
    border-top: 5px solid var(--card-accent);
    background: var(--paper);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .radar-vitals :global(.radar-forecasts li:nth-child(2)) {
    --card-accent: var(--mum);
  }

  .radar-vitals :global(.radar-forecasts li:nth-child(3)) {
    --card-accent: var(--focus);
  }

  .radar-vitals :global(.radar-forecasts h3) {
    margin: 0;
    font-size: var(--fs-s);
  }

  .radar-vitals :global(.radar-forecasts strong) {
    font-size: clamp(32px, 6vw, 54px);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .radar-vitals :global(.radar-bar) {
    height: 8px;
    border: 1.5px solid var(--ink);
    background: color-mix(in srgb, var(--stone) 70%, transparent);
    overflow: hidden;
  }

  .radar-vitals :global(.radar-bar span) {
    display: block;
    height: 100%;
    background: var(--card-accent);
  }

  .radar-vitals :global(.radar-sub) {
    font-size: var(--fs-xs);
    opacity: 0.78;
  }

  .radar-vitals :global(.radar-updated) {
    margin: 14px 0 0;
    font-size: var(--fs-xs);
    opacity: 0.82;
  }

  .radar-history {
    margin-top: 24px;
    border: 2px solid var(--ink);
    background: var(--paper);
    box-shadow: 4px 4px 0 var(--ink);
    padding: clamp(14px, 3vw, 24px);
  }

  .radar-notes {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--stone-shade);
    display: grid;
    gap: 10px;
  }

  .radar-notes h2 {
    margin: 0;
    font-size: var(--fs-m);
    font-family: var(--font-carve);
  }

  .radar-notes p {
    font-size: var(--fs-s);
    opacity: 0.88;
  }

  .radar-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin-top: 4px;
    font-size: var(--fs-xs);
  }

  .radar-links a {
    padding: 5px 10px;
    border: 1.5px solid var(--ink);
    text-decoration: none;
  }

  .radar-links a:hover,
  .radar-links a:focus-visible {
    background: var(--ink);
    color: var(--paper);
  }

  .radar-history-head,
  .radar-trend-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
  }

  .radar-history-head {
    justify-content: space-between;
  }

  .radar-history h2 {
    margin: 0;
    font-size: var(--fs-l);
    font-family: var(--font-carve);
  }

  .radar-trend-legend {
    list-style: none;
    padding: 0;
    margin: 10px 0 6px;
  }

  .radar-trend-legend :global(li)::before {
    content: '';
    display: inline-block;
    width: 14px;
    height: 3px;
    margin-inline-end: 6px;
    vertical-align: middle;
    background: var(--trend-color);
  }

  .radar-trend-legend :global([data-series='codex']) {
    --trend-color: light-dark(#38774c, #86d39d);
  }

  .radar-trend-legend :global([data-series='claude']) {
    --trend-color: light-dark(#93600f, #f7c557);
  }

  .radar-trend-legend :global([data-series='antigravity']) {
    --trend-color: var(--focus);
  }

  canvas {
    display: block;
    width: 100%;
    height: clamp(188px, 35vw, 312px);
  }

  .radar-history-head p,
  .radar-trend-legend,
  .radar-trend-readout,
  .radar-trend-help {
    font-size: var(--fs-xs);
  }

  .radar-trend-readout {
    min-height: 1.6em;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 450px) {
    .radar-vitals :global(.radar-forecasts) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .radar-vitals :global(.radar-forecasts li:only-child),
    .radar-vitals :global(.radar-forecasts li:nth-child(3):last-child) {
      grid-column: 1 / -1;
    }
  }
</style>
