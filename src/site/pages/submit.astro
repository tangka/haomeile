---
import SiteLayout from '../layouts/SiteLayout.astro';
import TombForm from '../components/TombForm.astro';
import CredentialDialog from '../components/CredentialDialog.astro';
---

<SiteLayout
  title="立一块碑 · 号没了"
  description="匿名记录你的 AI 账号是怎么没的。"
  path="/submit"
  current="/submit"
  robots="noindex,follow"
>
  <main class="page">
    <div class="wrap">
      <div class="page-head">
        <h1 id="submit-title">立一块碑</h1>
        <p id="submit-description">
          写下账号是怎么没的。审核通过后会出现在纪念墙上，你随时可以修改或撤回。
        </p>
      </div>
      <div class="notice" role="note">
        <strong>这些信息不要填</strong>邮箱、密码、API
        Key、订单号、手机号、微信或
        QQ、链接、证件号码。碑文是公开的，填了会被拦下来。
      </div>
      <form class="form" id="edit-credential-form" hidden>
        <div class="row-2">
          <div class="field">
            <label for="edit-id">编号</label>
            <input
              class="input"
              id="edit-id"
              autocomplete="off"
              spellcheck="false"
              required
            />
          </div>
          <div class="field">
            <label for="edit-secret">密钥</label>
            <input
              class="input"
              id="edit-secret"
              type="password"
              autocomplete="off"
              required
            />
          </div>
        </div>
        <div class="actions">
          <button class="btn btn-primary" type="submit">
            读取我的墓碑
          </button>
        </div>
        <div
          class="banner banner-error"
          id="edit-error"
          role="alert"
          hidden
        ></div>
      </form>
      <TombForm />
    </div>
  </main>
  <CredentialDialog />
  <script>
    import '../scripts/submit';
  </script>
</SiteLayout>
