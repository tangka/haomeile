---
import SiteLayout from '../layouts/SiteLayout.astro';
import TombForm from '../components/TombForm.astro';
import CredentialDialog from '../components/CredentialDialog.astro';
import PostingRulesDialog from '../components/PostingRulesDialog.astro';
---

<SiteLayout
  title="立一块碑 · 号没了"
  description="匿名记录你的 Claude、Codex 或 Antigravity 账号是怎么没的。"
  path="/submit"
  current="/submit"
  robots="noindex,follow"
>
  <main class="page submit-page">
    <div class="wrap">
      <div class="page-head">
        <div class="submit-heading">
          <h1 id="submit-title">立一块碑</h1>
          <button
            class="btn btn-quiet"
            type="button"
            id="open-posting-rules"
            aria-haspopup="dialog"
            aria-controls="posting-rules"
          >
            使用须知
          </button>
        </div>
        <p id="submit-description">
          写下账号是怎么没的。审核通过后会出现在纪念墙上，你随时可以修改或撤回。
        </p>
      </div>
      <p class="notice" role="note">
        碑文会公开。别填邮箱、手机号等私人信息。
      </p>
      <form class="form" id="edit-credential-form" hidden>
        <div class="row-2">
          <div class="field">
            <label for="edit-id">编号</label>
            <input
              class="input"
              id="edit-id"
              autocomplete="off"
              spellcheck="false"
              required
            />
          </div>
          <div class="field">
            <label for="edit-secret">密钥</label>
            <input
              class="input"
              id="edit-secret"
              type="password"
              autocomplete="off"
              required
            />
          </div>
        </div>
        <div class="actions">
          <button class="btn btn-primary" type="submit">
            读取我的墓碑
          </button>
        </div>
        <div
          class="banner banner-error"
          id="edit-error"
          role="alert"
          hidden
        ></div>
      </form>
      <TombForm />
    </div>
  </main>
  <PostingRulesDialog />
  <CredentialDialog />
  <script>
    import '../scripts/submit';
  </script>
</SiteLayout>

<style>
  .submit-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
  }

  .submit-page > .wrap {
    --max: 820px;
  }

  .submit-page :is(.page-head, .notice),
  .submit-page :global(.form) {
    max-width: none;
  }

  .submit-page .notice {
    border: 0;
    border-inline-start: 4px solid var(--mum);
    background: color-mix(in srgb, var(--mum) 12%, var(--paper));
    padding: 10px 12px;
  }

  .submit-page :global(.row-2) {
    align-items: start;
  }

  @media (min-width: 620px) {
    .submit-page :global(.row-2) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .submit-page :global(.field) {
    min-inline-size: 0;
  }

  .submit-page :global(.field > :is(.input, .select)) {
    block-size: 3rem;
    min-inline-size: 0;
    line-height: 1.4;
  }

  .submit-page :global(.field > legend) {
    margin-block-end: 6px;
    padding: 0;
  }
</style>
