---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout
  title="管理雷达邮件提醒 · 号没了"
  description="确认或退订重置雷达的邮件提醒。"
  path="/radar/email"
  current="/radar"
  robots="noindex,nofollow"
>
  <meta slot="head" name="referrer" content="no-referrer" />
  <main class="page" data-radar-email-manage>
    <div class="wrap">
      <div class="page-head">
        <h1>管理雷达邮件提醒</h1>
        <p role="status" data-radar-email-status>
          请打开邮件中的确认或退订链接。
        </p>
      </div>
      <div class="actions">
        <button
          class="btn btn-primary"
          type="button"
          data-radar-email-action
          hidden
        >
          确认订阅
        </button>
        <a href="/radar">返回重置雷达</a>
      </div>
    </div>
  </main>
  <script>
    import '../../scripts/radar-email';
  </script>
</SiteLayout>
