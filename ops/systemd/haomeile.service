[Unit]
Description=Haomeile memorial wall
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=haomeile
Group=haomeile
WorkingDirectory=/opt/haomeile/current
EnvironmentFile=/etc/haomeile/haomeile.env
ExecStart=/opt/haomeile/current/haomeile-server serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/haomeile /var/backups/haomeile
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=128M
MemoryMax=256M
CPUQuota=100%
TasksMax=128
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
