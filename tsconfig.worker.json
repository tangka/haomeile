{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": [
      "@cloudflare/workers-types",
      "node",
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "include": [
    "src/worker/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/api/**/*.ts",
    "tests/setup.ts",
    "tests/env.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
