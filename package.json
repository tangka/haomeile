{
  "name": "haomeile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.6.12",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "astro build",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts *.json *.mjs *.ts *.toml *.md",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply haomeile --local",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "astro": "7.4.13",
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@cloudflare/vitest-plugin": "1.8.5",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "10.0.1",
    "@playwright/test": "latest",
    "@types/node": "^24.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "latest",
    "globals": "latest",
    "prettier": "latest",
    "prettier-plugin-astro": "latest",
    "typescript": "^5.9.0",
    "typescript-eslint": "latest",
    "vitest": "~4.1.0",
    "wrangler": "4.165.0"
  }
}
